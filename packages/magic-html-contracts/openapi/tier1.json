  "components": {
    "securitySchemes": {
      "serviceBearer": {"type": "http", "scheme": "bearer", "description": "A trusted service credential. The caller authenticates and authorizes end users for tenant/site scope and asserts actor identity."}
    },
    "parameters": {
      "Tenant": {"name": "tenant", "in": "path", "required": true, "schema": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,99}$"}},
      "Site": {"name": "site", "in": "path", "required": true, "schema": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,99}$"}},
      "Interview": {"name": "interview", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}},
      "InterviewIdempotencyKey": {"name": "Idempotency-Key", "in": "header", "required": false, "description": "Optional import idempotency key. Exact retries return the existing completed session; reuse for changed input returns 409.", "schema": {"type": "string", "minLength": 8, "maxLength": 200}},
      "InterviewWriteIdempotencyKey": {"name": "Idempotency-Key", "in": "header", "required": true, "description": "Opaque start or answer key scoped to the relevant site and, for answers, interview session. Exact retries replay the original status and body; changed input or work already in progress returns 409.", "schema": {"type": "string", "minLength": 8, "maxLength": 200}},
      "KnowledgeBase": {"name": "knowledgeBase", "in": "path", "required": true, "description": "Knowledge base UUID resolved together with the tenant scope; cross-tenant lookup must return 404.", "schema": {"type": "string", "format": "uuid"}},
      "KnowledgeIngestionJob": {"name": "ingestionJob", "in": "path", "required": true, "description": "Ingestion job UUID resolved together with tenant and knowledge-base scope.", "schema": {"type": "string", "format": "uuid"}},
      "KnowledgeIdempotencyKey": {"name": "Idempotency-Key", "in": "header", "required": true, "description": "Opaque key scoped to the authenticated tenant and operation. Exact retries replay the original response; reuse with changed input returns 409.", "schema": {"type": "string", "minLength": 8, "maxLength": 200}},
      "Approval": {"name": "approval", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}},
      "IdempotencyKey": {"name": "Idempotency-Key", "in": "header", "required": true, "description": "Opaque globally unique key. Exact retries replay the original status and body; reuse for another operation or input returns 409.", "schema": {"type": "string", "minLength": 8, "maxLength": 200}}
    },
    "headers": {
      "IdempotentReplayed": {"description": "Whether this response is an exact replay of a completed operation.", "schema": {"type": "string", "enum": ["true", "false"]}}
    },
    "responses": {
      "InterviewProblem": {"description": "Interview API problem", "content": {"application/json": {"schema": {"$ref": "../schemas/v1/interview/problem.json"}}}},
      "KnowledgeProblem": {"description": "Knowledge API problem", "content": {"application/json": {"schema": {"$ref": "../schemas/v1/knowledge/problem.json"}}}},
      "ApprovalProblem": {"description": "Approval API problem", "content": {"application/json": {"schema": {"$ref": "../schemas/v1/approval/problem.json"}}}}
    }
  }
}
