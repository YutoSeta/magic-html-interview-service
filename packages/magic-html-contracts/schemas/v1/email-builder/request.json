{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.magic-html.dev/v1/email-builder/request.json",
  "title": "HTML email build request",
  "type": "object",
  "required": ["contract_version", "email_id", "subject", "blocks"],
  "additionalProperties": false,
  "properties": {
    "contract_version": {"const": "1.0"},
    "email_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,99}$"},
    "subject": {"type": "string", "minLength": 1, "maxLength": 300},
    "preheader": {"type": "string", "maxLength": 500},
    "locale": {"type": "string", "minLength": 2, "maxLength": 20, "default": "ja-JP"},
    "blocks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["type", "text"],
            "additionalProperties": false,
            "properties": {
              "type": {"const": "heading"},
              "level": {"type": "integer", "minimum": 1, "maximum": 3},
              "text": {"type": "string", "minLength": 1, "maxLength": 500}
            }
          },
          {
            "type": "object",
            "required": ["type", "text"],
            "additionalProperties": false,
            "properties": {
              "type": {"const": "text"},
              "text": {"type": "string", "minLength": 1, "maxLength": 8000}
            }
          },
          {
            "type": "object",
            "required": ["type", "url", "alt"],
            "additionalProperties": false,
            "properties": {
              "type": {"const": "image"},
              "url": {"type": "string", "format": "uri", "maxLength": 2048},
              "alt": {"type": "string", "maxLength": 500},
              "link_url": {"type": "string", "format": "uri", "maxLength": 2048}
            }
          },
          {
            "type": "object",
            "required": ["type", "label", "url"],
            "additionalProperties": false,
            "properties": {
              "type": {"const": "button"},
              "label": {"type": "string", "minLength": 1, "maxLength": 200},
              "url": {"type": "string", "format": "uri", "maxLength": 2048}
            }
          },
          {
            "type": "object",
            "required": ["type"],
            "additionalProperties": false,
            "properties": {"type": {"const": "divider"}}
          },
          {
            "type": "object",
            "required": ["type", "size"],
            "additionalProperties": false,
            "properties": {
              "type": {"const": "spacer"},
              "size": {"enum": ["sm", "md", "lg"]}
            }
          }
        ]
      }
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "surface": {"enum": ["light", "muted", "dark"]},
        "primary_color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
        "text_color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
        "font_family": {"enum": ["sans", "serif", "mono"]},
        "content_width": {"type": "integer", "minimum": 320, "maximum": 720}
      }
    },
    "source_refs": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": ["service", "resource", "version"],
        "additionalProperties": false,
        "properties": {
          "service": {"enum": ["content", "collection", "media", "publication"]},
          "resource": {"type": "string", "minLength": 1, "maxLength": 200},
          "version": {"type": "string", "minLength": 1, "maxLength": 200}
        }
      }
    }
  }
}
