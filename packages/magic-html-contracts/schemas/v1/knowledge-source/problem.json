{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.magic-html.dev/v1/knowledge-source/problem.json",
  "title": "Knowledge source API problem",
  "type": "object",
  "required": ["contract_version", "type", "title", "status", "detail", "request_id"],
  "additionalProperties": false,
  "properties": {
    "contract_version": {"const": "1.0"},
    "type": {"type": "string", "minLength": 1, "maxLength": 100},
    "title": {"type": "string", "minLength": 1, "maxLength": 255},
    "status": {"enum": [401, 404, 409, 413, 422, 502, 503]},
    "detail": {"type": "string", "minLength": 1, "maxLength": 2000},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 255},
    "errors": {"type": "object", "maxProperties": 50, "additionalProperties": {"type": "array", "maxItems": 20, "items": {"type": "string", "maxLength": 1000}}}
  }
}
