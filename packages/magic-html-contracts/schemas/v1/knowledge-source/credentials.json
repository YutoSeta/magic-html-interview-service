{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.magic-html.dev/v1/knowledge-source/credentials.json",
  "title": "Knowledge source write-only credentials",
  "description": "Write-only driver credentials. This schema is accepted only on connection writes and is never referenced by a response.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "client_email": {"type": "string", "format": "email", "maxLength": 320},
    "private_key": {"type": "string", "minLength": 1, "maxLength": 20000},
    "subject": {"type": "string", "maxLength": 320},
    "username": {"type": "string", "maxLength": 320},
    "application_password": {"type": "string", "maxLength": 20000},
    "access_key_id": {"type": "string", "maxLength": 1000},
    "secret_access_key": {"type": "string", "maxLength": 20000},
    "session_token": {"type": "string", "maxLength": 20000},
    "bot_secret": {"type": "string", "maxLength": 20000}
  }
}
