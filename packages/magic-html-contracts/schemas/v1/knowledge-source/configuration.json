{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.magic-html.dev/v1/knowledge-source/configuration.json",
  "title": "Knowledge source safe configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "folder_id": {"type": "string", "minLength": 10, "maxLength": 200, "pattern": "^[A-Za-z0-9_-]+$"},
    "include_nested": {"type": "boolean", "default": true},
    "feed_url": {"type": "string", "format": "uri", "maxLength": 2048, "pattern": "^https://"},
    "max_items": {"type": "integer", "minimum": 1, "maximum": 500},
    "base_url": {"type": "string", "format": "uri", "maxLength": 2048, "pattern": "^https://"},
    "post_types": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"enum": ["posts", "pages"]}},
    "per_page": {"type": "integer", "minimum": 1, "maximum": 100},
    "bucket": {"type": "string", "minLength": 1, "maxLength": 255},
    "region": {"type": "string", "minLength": 1, "maxLength": 100},
    "prefix": {"type": "string", "maxLength": 1024},
    "endpoint": {"type": "string", "format": "uri", "maxLength": 2048, "pattern": "^https://"},
    "path_style": {"type": "boolean", "default": false},
    "max_documents": {"type": "integer", "minimum": 1, "maximum": 500},
    "bot_id": {"type": "string", "minLength": 1, "maxLength": 100},
    "max_event_age_seconds": {"type": "integer", "minimum": 60, "maximum": 3600, "default": 300}
  }
}
