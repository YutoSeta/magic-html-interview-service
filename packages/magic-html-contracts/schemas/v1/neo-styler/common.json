{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.magic-html.dev/v1/neo-styler/common.json",
  "title": "Neo Styler Shared Definitions",
  "description": "Neo Styler authors whole pages by letting a model write HTML and CSS directly, inside a fixed set of seat belts: every word on a page comes from a named slot derived from the Site AST and content, header / footer / CV bar / form HTML is fixed and only styled, links are slots whose destinations the service resolves, and each page is judged deterministically (browser render at 320px and 1280px, slot usage, extra links) and regenerated with feedback until it passes or the retry budget is spent. Copy, links and images are declared here; the model decides only how they look.",
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "executionProfile": {
      "type": "string",
      "enum": ["fast", "balanced", "quality"],
      "default": "balanced",
      "description": "Stable server-owned execution profile. balanced is the default that the authoring benchmark was run with; fast trades cost for latency on the same model; quality uses the highest-reasoning model. Concrete provider model names are not caller-controlled."
    },
    "key": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$", "maxLength": 40, "description": "A section, page or collection key. It appears in slot names (section-<key>-…) and in-page anchors (#<key>)." },
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "maxLength": 60 },
    "slotName": { "type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$", "maxLength": 120, "description": "A slot name without the @ prefix: logo, nav-1-text, hero-title, section-<key>-<field>, section-<key>-items-<n>-<field>, section-<key>-link-text / -link-href, footer-<n>-text / -href, cv-label / cv-href, form-…" },
    "linkTarget": {
      "type": "string",
      "enum": ["form", "section", "external", "tel", "mail"],
      "description": "Where a link goes. The model never sees a raw destination: form resolves to the page's form anchor, section to #<key> of an existing section, external to an https URL, tel to tel:<digits>, mail to mailto:<address>. target=\"_blank\" rel=\"noopener\" is added to external links by the service."
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "target"],
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 60 },
        "target": { "$ref": "#/$defs/linkTarget" },
        "to": { "type": "string", "maxLength": 2048, "description": "section: the section key; external: the URL; tel: the phone number; mail: the address. Absent for form." }
      },
      "allOf": [
        { "if": { "properties": { "target": { "const": "form" } } }, "then": { "not": { "required": ["to"] } } },
        { "if": { "properties": { "target": { "const": "section" } } }, "then": { "required": ["to"], "properties": { "to": { "$ref": "#/$defs/key" } } } },
        { "if": { "properties": { "target": { "const": "external" } } }, "then": { "required": ["to"], "properties": { "to": { "type": "string", "pattern": "^https?://" } } } },
        { "if": { "properties": { "target": { "const": "tel" } } }, "then": { "required": ["to"], "properties": { "to": { "type": "string", "pattern": "^\\+?[0-9][0-9 ()-]{5,30}$" } } } },
        { "if": { "properties": { "target": { "const": "mail" } } }, "then": { "required": ["to"], "properties": { "to": { "type": "string", "format": "email" } } } }
      ]
    },
    "imageSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aspect", "prompt"],
      "properties": {
        "aspect": { "enum": ["3:2", "2:3", "4:3", "3:4", "1:1", "16:9"] },
        "mime": { "enum": ["image/jpeg", "image/png", "image/webp"], "default": "image/jpeg", "description": "image/jpeg for photographs, image/png for illustrations and anything with transparency." },
        "transparent": { "type": "boolean", "default": false },
        "prompt": { "type": "string", "minLength": 1, "maxLength": 2000, "description": "What to draw, in the site's language. Passed unedited to image generation." }
      }
    },
    "item": {
      "type": "object",
      "description": "One entry of a section's items or rows: free string fields (name, text, step, key, value …) plus at most one image and one link.",
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$", "not": { "enum": ["href", "path", "url"] } },
      "properties": {
        "image": { "$ref": "#/$defs/imageSpec" },
        "link": { "$ref": "#/$defs/link" }
      },
      "additionalProperties": { "type": "string", "maxLength": 4000 },
      "maxProperties": 12
    },
    "section": {
      "type": "object",
      "description": "A section is a key and free fields. A string becomes one slot (section-<key>-<field>); a list of strings becomes numbered slots (-<field>-<n>); items and rows become numbered per-field slots (-items-<n>-<field>); image / images become image slots; link becomes -link-text and -link-href. href, path and url are refused: a destination is always declared as a link.",
      "required": ["key"],
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$", "not": { "enum": ["href", "path", "url"] } },
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "image": { "$ref": "#/$defs/imageSpec" },
        "images": { "type": "array", "minItems": 1, "maxItems": 10, "items": { "$ref": "#/$defs/imageSpec" } },
        "link": { "$ref": "#/$defs/link" },
        "items": { "type": "array", "minItems": 1, "maxItems": 50, "items": { "oneOf": [ { "type": "string", "maxLength": 4000 }, { "$ref": "#/$defs/item" } ] } },
        "rows": { "type": "array", "minItems": 1, "maxItems": 50, "items": { "$ref": "#/$defs/item" } },
        "paragraphs": { "type": "array", "minItems": 1, "maxItems": 30, "items": { "type": "string", "maxLength": 4000 } }
      },
      "additionalProperties": {
        "oneOf": [
          { "type": "string", "maxLength": 4000 },
          { "type": "array", "minItems": 1, "maxItems": 50, "items": { "type": "string", "maxLength": 4000 } }
        ]
      },
      "maxProperties": 20
    },
    "formField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "label", "type"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$", "maxLength": 40 },
        "label": { "type": "string", "minLength": 1, "maxLength": 100 },
        "type": { "enum": ["text", "email", "tel", "url", "textarea", "select", "checkbox"] },
        "required": { "type": "boolean", "default": false },
        "options": { "type": "array", "maxItems": 50, "items": { "type": "string", "maxLength": 100 } },
        "placeholder": { "type": "string", "maxLength": 200 },
        "rows": { "type": "integer", "minimum": 1, "maximum": 20 },
        "autocomplete": { "type": "string", "maxLength": 40 }
      }
    },
    "form": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fields"],
      "properties": {
        "key": { "$ref": "#/$defs/key", "default": "contact", "description": "The form's id on the page and its Forms Service definition name." },
        "notice": { "type": "string", "maxLength": 1000 },
        "submit_label": { "type": "string", "maxLength": 40 },
        "success_message": { "type": "string", "maxLength": 500 },
        "error_message": { "type": "string", "maxLength": 500 },
        "fields": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "$ref": "#/$defs/formField" } }
      }
    },
    "brief": {
      "type": "object",
      "description": "The hearing as field path → value, as an intake session returns it. Paths follow template/field.json. The landing-page intake template (tests/fixtures/neo-styler/landing-intake-template.json) defines the paths materialize and propose read: site_name, offer, cv_goal, cv_label, cv_note, business_name are the ones they require.",
      "propertyNames": { "pattern": "^[A-Za-z][A-Za-z0-9_-]*(\\.[A-Za-z][A-Za-z0-9_-]*)*$", "maxLength": 128 },
      "additionalProperties": {
        "oneOf": [
          { "type": "string", "maxLength": 8000 },
          { "type": "number" },
          { "type": "boolean" },
          { "type": "array", "maxItems": 100, "items": { "type": "string", "maxLength": 2000 } }
        ]
      },
      "maxProperties": 100
    },
    "designContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dna", "direction", "visual_references"],
      "description": "Produced by the Design Context service and passed through unchanged. The model reads the direction prose and looks at the canvases; the DNA is kept for provenance and is not shown to the model.",
      "properties": {
        "dna": { "type": "object", "minProperties": 1, "maxProperties": 64 },
        "direction": { "type": "string", "minLength": 1, "maxLength": 20000 },
        "visual_references": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "contains": { "type": "object", "required": ["kind"], "properties": { "kind": { "const": "design-canvas" } } },
          "minContains": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "mime", "base64", "sha256"],
            "properties": {
              "kind": { "type": "string", "minLength": 1, "maxLength": 64 },
              "viewport": { "enum": ["desktop", "mobile"], "description": "For a design-canvas: which screen it depicts. With both, mobile is the baseline and desktop its expansion." },
              "mime": { "enum": ["image/png", "image/jpeg", "image/webp"] },
              "base64": { "type": "string", "minLength": 4, "maxLength": 8388608, "contentEncoding": "base64" },
              "sha256": { "$ref": "#/$defs/sha256" },
              "caption": { "type": "string", "maxLength": 500 }
            }
          }
        }
      }
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "provider_request_count", "duration_ms", "input_tokens", "output_tokens", "cost_micro_usd"],
      "properties": {
        "provider": { "type": "string", "minLength": 1, "maxLength": 100 },
        "model": { "type": "string", "minLength": 1, "maxLength": 255 },
        "provider_request_count": { "type": "integer", "minimum": 0 },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "input_tokens": { "type": "integer", "minimum": 0 },
        "cached_input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "reasoning_tokens": { "type": "integer", "minimum": 0 },
        "cost_micro_usd": { "type": "integer", "minimum": 0, "description": "Provider cost in millionths of a US dollar, summed over every request the operation made." }
      }
    },
    "jobEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "id", "operation", "status", "created_at", "updated_at"],
      "properties": {
        "contract_version": { "const": "1.0" },
        "id": { "type": "string", "format": "uuid" },
        "operation": { "enum": ["propose", "materialize", "author"] },
        "status": { "enum": ["queued", "running", "succeeded", "failed"] },
        "progress": { "type": "number", "minimum": 0, "maximum": 1 },
        "stage": { "type": "string", "maxLength": 80, "description": "What the job is doing now, for people: e.g. page:home attempt 2, images 3/5." },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" },
        "result": { "type": "object" },
        "error": { "type": "object" }
      }
    }
  }
}
