{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://magic-html.example/schemas/v1/styler/stage-bundle.json",
  "title": "Styler Stage Bundle",
  "description": "Immutable structural context for the layout, skin, decor, and motion pipeline. A stage is never transported as detached CSS: source structure, intent, viewports, semantic bindings, and every upstream AST/CSS pair travel together and are digest-bound.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "page_key", "annotated_html", "bindings", "brief", "viewports", "stages", "digests"],
  "properties": {
    "version": { "const": 1 },
    "page_key": { "type": "string", "minLength": 1, "maxLength": 255 },
    "annotated_html": { "type": "string", "minLength": 1, "maxLength": 2000000 },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5000,
      "items": { "type": "object", "minProperties": 1 }
    },
    "brief": { "type": "string", "minLength": 1, "maxLength": 50000 },
    "viewports": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["width", "height"],
        "properties": {
          "width": { "type": "integer", "minimum": 320, "maximum": 10000 },
          "height": { "type": "integer", "minimum": 240, "maximum": 10000 }
        }
      }
    },
    "design_context": { "$ref": "./design-context.json" },
    "stages": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "layout": { "$ref": "#/$defs/stage" },
        "skin": { "$ref": "#/$defs/stage" },
        "decor": { "$ref": "#/$defs/stage" },
        "motion": { "$ref": "#/$defs/stage" }
      }
    },
    "digests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_html", "annotated_html", "bindings", "context"],
      "properties": {
        "source_html": { "$ref": "#/$defs/digest" },
        "annotated_html": { "$ref": "#/$defs/digest" },
        "bindings": { "$ref": "#/$defs/digest" },
        "context": { "$ref": "#/$defs/digest" }
      }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ast", "css", "ast_digest", "css_digest"],
      "properties": {
        "ast": { "type": "object", "minProperties": 1 },
        "css": { "type": "string", "minLength": 1, "maxLength": 2000000 },
        "ast_digest": { "$ref": "#/$defs/digest" },
        "css_digest": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
