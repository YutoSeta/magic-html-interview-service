{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.magic-html.dev/v1/style/job-request.json",
  "title": "Single-page styling job request",
  "type": "object",
  "required": ["contract_version", "page_key", "html", "brief", "viewports"],
  "additionalProperties": false,
  "properties": {
    "contract_version": {"const": "1.0"},
    "page_key": {"type": "string", "minLength": 1, "maxLength": 255},
    "html": {"type": "string", "minLength": 1},
    "brief": {"type": "string", "minLength": 1, "maxLength": 12000},
    "viewports": {
      "type": "array", "minItems": 1, "maxItems": 8,
      "items": {
        "type": "object", "required": ["width", "height"], "additionalProperties": false,
        "properties": {
          "width": {"type": "integer", "minimum": 320, "maximum": 7680},
          "height": {"type": "integer", "minimum": 240, "maximum": 4320}
        }
      }
    },
    "current_design_ast": {"$ref": "../design/design-ast.json"},
    "feedback": {"type": "string", "maxLength": 4000},
    "refine_limit": {"type": "integer", "minimum": 0, "maximum": 5, "default": 0}
  }
}
