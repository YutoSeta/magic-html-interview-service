{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.magic-html.dev/v1/messaging/conversation-list-query.json",
  "title": "Messaging conversation list query",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "status": {"enum": ["open", "closed"]},
    "q": {"type": "string", "minLength": 1, "maxLength": 100, "description": "Substring search across subject and external_conversation_id."},
    "page": {"type": "integer", "minimum": 1, "maximum": 10000, "default": 1},
    "per_page": {"type": "integer", "minimum": 1, "maximum": 50, "default": 20}
  }
}
