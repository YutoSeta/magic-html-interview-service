{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.magic-html.dev/v1/channel/problem.json",
  "title": "Channel API Problem",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "title", "status", "detail"],
  "properties": {
    "type": {"enum": ["unauthenticated", "validation_failed", "channel_record_not_found", "idempotency_conflict", "idempotency_in_progress", "channel_version_conflict", "invalid_credentials", "invalid_connection", "invalid_content", "provider_rejected", "provider_unavailable", "provider_rate_limited", "unsupported_provider", "delivery_unknown", "invalid_provider_response", "payload_too_large", "rate_limited"]},
    "title": {"type": "string", "minLength": 1, "maxLength": 100},
    "status": {"enum": [401, 404, 409, 413, 422, 429, 503]},
    "detail": {"type": "string", "minLength": 1, "maxLength": 1000},
    "errors": {"type": "object", "additionalProperties": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "maxLength": 1000}}},
    "current_version": {"type": "integer", "minimum": 1}
  },
  "allOf": [
    {"if": {"properties": {"type": {"const": "validation_failed"}}, "required": ["type"]}, "then": {"required": ["errors"]}},
    {"if": {"properties": {"type": {"const": "channel_version_conflict"}}, "required": ["type"]}, "then": {"required": ["current_version"]}}
  ]
}
