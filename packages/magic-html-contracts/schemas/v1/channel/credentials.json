{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.magic-html.dev/v1/channel/credentials.json",
  "title": "Channel write-only provider credentials",
  "type": "object",
  "additionalProperties": false,
  "minProperties": 1,
  "maxProperties": 1,
  "properties": {
    "access_token": {"type": "string", "minLength": 8, "maxLength": 8192, "writeOnly": true},
    "channel_access_token": {"type": "string", "minLength": 8, "maxLength": 8192, "writeOnly": true}
  },
  "oneOf": [{"required": ["access_token"]}, {"required": ["channel_access_token"]}]
}
