{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.magic-html.dev/v1/image/generation-result.json",
  "title": "Generated image",
  "type": "object",
  "required": ["contract_version", "mime_type", "content_base64", "provider", "model"],
  "properties": {
    "contract_version": {"const": "1.0"},
    "mime_type": {"enum": ["image/png", "image/jpeg", "image/webp"]},
    "content_base64": {"type": "string", "minLength": 1},
    "provider": {"type": "string", "minLength": 1},
    "model": {"type": "string", "minLength": 1},
    "input_tokens": {"type": "integer", "minimum": 0},
    "output_tokens": {"type": "integer", "minimum": 0},
    "request_id": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
