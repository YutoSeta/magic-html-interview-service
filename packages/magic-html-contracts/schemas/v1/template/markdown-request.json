{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.magic-html.dev/v1/template/markdown-request.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "markdown"],
