{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.magic-html.dev/v1/slide/request.json",
  "title": "Slide validation or render request",
  "type": "object",
  "required": ["contract_version", "ast"],
  "properties": {
    "contract_version": {"const": "1.0"},
    "ast": {"type": "object"},
    "design": {"type": "object"},
    "options": {
      "type": "object",
      "properties": {
        "width": {"type": "integer", "minimum": 320, "maximum": 7680},
        "height": {"type": "integer", "minimum": 240, "maximum": 4320}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
