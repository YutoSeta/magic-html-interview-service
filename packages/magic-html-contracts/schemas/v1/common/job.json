{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.magic-html.dev/v1/common/job.json",
  "title": "Asynchronous job",
  "type": "object",
  "required": ["contract_version", "id", "status", "created_at", "updated_at"],
  "properties": {
    "contract_version": {"const": "1.0"},
    "id": {"type": "string", "minLength": 1},
    "status": {"enum": ["queued", "running", "succeeded", "failed", "cancelled", "expired"]},
    "progress": {"type": "number", "minimum": 0, "maximum": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "error": {"anyOf": [{"type": "null"}, {"$ref": "problem.json"}]}
  },
  "additionalProperties": true
}
