{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.magic-html.dev/v1/wireframe/materialize-result.json",
  "title": "Legacy Wireframe Materialize Result 1.1 Compatibility Artifact",
  "description": "Legacy compatibility artifact for Wireframe materialize contract 1.1 and Styler 1.1/1.2 consumers. Its approved-wireframe-layout-v1 AST/CSS handoff is not the authoritative Layout Snapshot carrying geometry-only Layout AST v2 and must not be used as the Styler 1.3 source of truth.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "source_digest", "entry_path", "files", "file_manifest", "wireframe_skin_ast", "wireframe_decor_ast", "layout", "handoff", "telemetry"],
  "properties": {
    "contract_version": { "const": "1.1" },
    "source_digest": { "$ref": "#/$defs/digest" },
    "entry_path": { "type": "string", "minLength": 1 },
    "files": { "$ref": "#/$defs/files" },
    "file_manifest": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "wireframe_skin_ast": { "type": "object", "minProperties": 1 },
    "wireframe_decor_ast": { "type": "object", "minProperties": 1 },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "profile", "status", "pages", "digest"],
      "properties": {
        "version": { "const": 1 },
        "profile": { "const": "approved-wireframe-layout-v1" },
        "status": { "const": "frozen" },
        "pages": { "type": "array", "minItems": 1, "items": { "$ref": "../styler/approved-layout.json" } },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "source_digest", "entry_path", "files", "file_manifest", "layout_digest", "approved_layouts"],
      "properties": {
        "profile": { "const": "styler-input-v2" },
        "source_digest": { "$ref": "#/$defs/digest" },
        "entry_path": { "type": "string", "minLength": 1 },
        "files": { "$ref": "#/$defs/files" },
        "file_manifest": { "type": "array", "minItems": 1, "items": { "type": "object" } },
        "layout_digest": { "$ref": "#/$defs/digest" },
        "approved_layouts": { "type": "array", "minItems": 1, "items": { "$ref": "../styler/approved-layout.json" } }
      }
    },
    "telemetry": { "type": "object" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "mime", "content_base64"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "mime": { "const": "text/html; charset=UTF-8" },
          "content_base64": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
