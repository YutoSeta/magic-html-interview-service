{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.magic-html.dev/v1/static-build/request.json",
  "title": "Static compilation request",
  "type": "object",
  "required": ["contract_version", "snapshot"],
  "properties": {
    "contract_version": {"const": "1.0"},
    "snapshot": {
      "type": "object",
      "required": ["id", "pages"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "pages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["path", "html"],
            "properties": {
              "path": {"type": "string", "pattern": "^/"},
              "html": {"type": "string"}
            },
            "additionalProperties": false
          }
        },
        "assets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "content_base64"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "content_base64": {"type": "string"}
            },
            "additionalProperties": false
          }
        },
        "design": {
          "type": "object",
          "properties": {"css": {"type": "string"}},
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
