{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.magic-html.dev/v1/approval/message-request.json",
  "title": "Add approval message request",
  "type": "object",
  "required": ["contract_version", "actor", "message"],
  "additionalProperties": false,
  "properties": {
    "contract_version": {"const": "1.0"},
    "actor": {"$ref": "actor.json"},
    "message": {"type": "string", "minLength": 1, "maxLength": 10000},
    "metadata": {"type": ["object", "array"], "maxProperties": 100, "maxItems": 100}
  }
}
