  "title": "Measurement mutation confirmation",
  "type": "object",
  "additionalProperties": false,
  "required": ["confirmed", "summary_digest"],
  "properties": {
    "confirmed": {"const": true},
    "summary_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
