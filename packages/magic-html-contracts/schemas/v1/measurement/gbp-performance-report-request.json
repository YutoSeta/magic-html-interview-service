{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.magic-html.dev/v1/measurement/gbp-performance-report-request.json",
  "title": "Google Business Profile performance report request",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "location_id", "start_date", "end_date", "metrics"],
  "properties": {
    "contract_version": {"const": "1.0"},
    "location_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,100}$"},
    "start_date": {"type": "string", "format": "date"},
    "end_date": {"type": "string", "format": "date"},
    "metrics": {"type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true, "items": {"enum": ["BUSINESS_IMPRESSIONS_DESKTOP_MAPS", "BUSINESS_IMPRESSIONS_DESKTOP_SEARCH", "BUSINESS_IMPRESSIONS_MOBILE_MAPS", "BUSINESS_IMPRESSIONS_MOBILE_SEARCH", "CALL_CLICKS", "WEBSITE_CLICKS", "BUSINESS_DIRECTION_REQUESTS"]}}
  },
  "description": "end_date must be on or after start_date and the date difference must not exceed 366 days."
}
