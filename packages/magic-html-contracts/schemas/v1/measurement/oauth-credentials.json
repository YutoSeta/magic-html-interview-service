{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.magic-html.dev/v1/measurement/oauth-credentials.json",
  "title": "Measurement delegated OAuth credentials",
  "type": "object",
  "additionalProperties": false,
  "required": ["client_id", "client_secret", "refresh_token"],
  "properties": {
    "client_id": {"type": "string", "minLength": 1, "maxLength": 16384, "pattern": "\\S", "writeOnly": true},
    "client_secret": {"type": "string", "minLength": 1, "maxLength": 16384, "pattern": "\\S", "writeOnly": true},
    "refresh_token": {"type": "string", "minLength": 1, "maxLength": 16384, "pattern": "\\S", "writeOnly": true}
  },
  "description": "Write-only credentials. No value from this object may appear in a response."
}
