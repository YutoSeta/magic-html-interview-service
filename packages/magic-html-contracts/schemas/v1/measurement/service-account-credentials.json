{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.magic-html.dev/v1/measurement/service-account-credentials.json",
  "title": "Measurement Google service-account credentials",
  "type": "object",
  "additionalProperties": false,
  "required": ["client_email", "private_key", "token_uri"],
  "properties": {
    "client_email": {"type": "string", "minLength": 1, "maxLength": 16384, "pattern": "\\S", "writeOnly": true},
    "private_key": {"type": "string", "minLength": 1, "maxLength": 16384, "pattern": "\\S", "writeOnly": true},
    "token_uri": {"const": "https://oauth2.googleapis.com/token", "writeOnly": true}
  },
  "description": "Write-only credentials. token_uri is accepted only as the fixed Google endpoint and is never caller-selectable."
}
