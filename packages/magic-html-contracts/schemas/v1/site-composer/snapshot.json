{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.magic-html.dev/v1/site-composer/snapshot.json",
  "title": "Immutable composed site snapshot",
  "type": "object",
  "required": ["contract_version", "site_id", "version", "digest", "published_at", "site_ast", "pages", "assets"],
  "additionalProperties": false,
  "properties": {
    "contract_version": {"const": "1.0"},
    "site_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^v[0-9]+-[a-f0-9]{12}$"},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "published_at": {"type": "string", "format": "date-time"},
    "site_ast": {"type": "object"},
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["key", "path", "title", "html", "css", "design_ast"],
        "additionalProperties": false,
        "properties": {
          "key": {"type": "string", "minLength": 1},
          "path": {"type": "string", "pattern": "^/"},
          "title": {"type": "string", "minLength": 1},
          "html": {"type": "string", "minLength": 1},
          "css": {"type": "string"},
          "design_ast": {
            "oneOf": [
              {"$ref": "../design/design-ast.json"},
              {"$ref": "../styler/pipeline-result.json#/properties/design_ast"}
            ]
          },
          "styling_diagnostics": {"$ref": "../styler/pipeline-result.json#/properties/diagnostics"}
        }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "mime", "url", "sha256"],
        "additionalProperties": false,
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "mime": {"type": "string", "minLength": 1},
          "url": {"type": "string", "format": "uri"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "refinement": {
      "type": "object",
      "required": ["used", "limit"],
      "additionalProperties": false,
      "properties": {
        "used": {"type": "integer", "minimum": 0, "maximum": 5},
        "limit": {"type": "integer", "minimum": 0, "maximum": 5}
      }
    }
  }
}
