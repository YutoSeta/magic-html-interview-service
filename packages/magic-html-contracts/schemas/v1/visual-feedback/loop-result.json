{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.magic-html.dev/v1/visual-feedback/loop-result.json",
  "title": "Bounded visual feedback convergence decision",
  "description": "Exact output of Magic HTML Design Core VisualFeedbackLoopPolicy 1.3.0. Four evaluations and three accepted patches are distinct budgets, allowing a final evaluation after the third patch and an explicit advisory-only human-review boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile", "policy_version", "policy_digest", "run_id", "state_digest", "verdict", "stop", "reason", "evaluations_used", "max_evaluations", "remaining_evaluations", "accepted_patches", "max_accepted_patches", "remaining_accepted_patches", "model_calls_used", "max_model_calls", "elapsed_ms", "max_elapsed_ms", "minimum_score_improvement_bp", "score_delta_bp", "next_subject_digest", "history_entry", "best_so_far"],
  "properties": {
    "profile": {"const": "bounded-visual-feedback-v1"},
    "policy_version": {"const": "1.3.0"},
    "policy_digest": {"$ref": "#/$defs/digest"},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"},
    "state_digest": {"$ref": "#/$defs/digest"},
    "verdict": {"enum": ["passed", "patch_required", "human_review_required"]},
    "stop": {"type": "boolean"},
    "reason": {"enum": ["quality_gate_passed", "evidence_incomplete", "quality_gap_has_no_finite_patch", "patch_no_op", "subject_cycle_detected", "model_budget_exhausted", "elapsed_budget_exhausted", "evaluation_budget_exhausted", "patch_budget_exhausted", "quality_regressed", "repeated_issue_set", "no_material_improvement", "finite_patch_available"]},
    "evaluations_used": {"type": "integer", "minimum": 1, "maximum": 4},
    "max_evaluations": {"type": "integer", "minimum": 1, "maximum": 4},
    "remaining_evaluations": {"type": "integer", "minimum": 0, "maximum": 3},
    "accepted_patches": {"type": "integer", "minimum": 0, "maximum": 3},
    "max_accepted_patches": {"type": "integer", "minimum": 0, "maximum": 3},
    "remaining_accepted_patches": {"type": "integer", "minimum": 0, "maximum": 3},
    "model_calls_used": {"type": "integer", "minimum": 0, "maximum": 100},
    "max_model_calls": {"type": "integer", "minimum": 1, "maximum": 100},
    "elapsed_ms": {"type": "integer", "minimum": 0},
    "max_elapsed_ms": {"type": "integer", "minimum": 1, "maximum": 3600000},
    "minimum_score_improvement_bp": {"const": 200},
    "score_delta_bp": {"type": ["integer", "null"], "minimum": -10000, "maximum": 10000},
    "next_subject_digest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "history_entry": {"$ref": "loop-context.json#/$defs/historyEntry"},
    "best_so_far": {"$ref": "loop-context.json#/$defs/historyEntry"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
