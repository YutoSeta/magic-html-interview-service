{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.magic-html.dev/v1/crm/person.json",
  "title": "CRM person",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "id", "tenant_id", "company_id", "name", "name_kana", "department", "title", "email", "phone", "mobile", "notes", "custom_fields", "version", "created_at", "updated_at"],
  "properties": {
    "contract_version": {"const": "1.0"},
    "id": {"type": "string", "format": "uuid"},
    "tenant_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,99}$"},
    "company_id": {"type": ["string", "null"], "format": "uuid", "description": "When present, identifies an active company in the same tenant. Company deletion never cascades to a person."},
    "name": {"type": "string", "minLength": 1, "maxLength": 200},
    "name_kana": {"type": ["string", "null"], "maxLength": 200},
    "department": {"type": ["string", "null"], "maxLength": 120},
    "title": {"type": ["string", "null"], "maxLength": 120},
    "email": {"type": ["string", "null"], "format": "email", "maxLength": 254},
    "phone": {"type": ["string", "null"], "maxLength": 50},
    "mobile": {"type": ["string", "null"], "maxLength": 50},
    "notes": {"type": ["string", "null"], "maxLength": 10000},
    "custom_fields": {"$ref": "custom-fields.json"},
    "version": {"type": "integer", "minimum": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  }
}
