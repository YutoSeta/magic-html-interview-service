{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.magic-html.dev/v1/crm/person-list-query.json",
  "title": "CRM person list query",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "q": {"type": "string", "maxLength": 200, "description": "Literal substring search across name, name_kana, department, and email."},
    "company_id": {"type": "string", "format": "uuid", "description": "Filters by an active company in the same tenant; another tenant or deleted company is rejected."},
    "sort": {"enum": ["created_at", "updated_at", "name"], "default": "created_at"},
    "direction": {"enum": ["asc", "desc"], "default": "desc"},
    "page": {"type": "integer", "minimum": 1, "default": 1},
    "per_page": {"type": "integer", "minimum": 1, "maximum": 100, "default": 25}
  }
}
