{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.magic-html.dev/v1/site-edit/request.json",
  "title": "Static page edit request",
  "type": "object",
  "required": ["contract_version", "site_id", "page_path", "base_digest", "html", "operations"],
  "additionalProperties": false,
  "properties": {
    "contract_version": {"const": "1.0"},
    "site_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,99}$"},
    "page_path": {"type": "string", "pattern": "^/", "maxLength": 1000},
    "base_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "html": {"type": "string", "minLength": 1, "maxLength": 2000000},
    "marker_locked": {"type": "boolean", "default": false},
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["op", "xpath", "value"],
        "additionalProperties": false,
        "properties": {
          "op": {"enum": ["replace_text", "replace_image", "replace_href"]},
          "xpath": {"type": "string", "pattern": "^/([a-z0-9-]+\\[[1-9][0-9]*\\]|text\\(\\)\\[[1-9][0-9]*\\])(/([a-z0-9-]+\\[[1-9][0-9]*\\]|text\\(\\)\\[[1-9][0-9]*\\]))*$", "maxLength": 2000},
          "value": {"type": "string", "minLength": 1, "maxLength": 100000},
          "alt": {"type": ["string", "null"], "maxLength": 1000}
        }
      }
    }
  }
}
