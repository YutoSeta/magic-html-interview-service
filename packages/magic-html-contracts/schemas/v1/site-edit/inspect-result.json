{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.magic-html.dev/v1/site-edit/inspect-result.json",
  "title": "Static page editable-target inspection result",
  "type": "object",
  "required": ["contract_version", "site_id", "page_path", "base_digest", "truncated", "candidates"],
  "additionalProperties": false,
  "properties": {
    "contract_version": {"const": "1.0"},
    "site_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,99}$"},
    "page_path": {"type": "string", "pattern": "^/", "maxLength": 1000},
    "base_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "SHA-256 lowercase hex of the exact HTML bytes supplied in the request."
    },
    "truncated": {
      "type": "boolean",
      "description": "True when candidates beyond the 200-item limit were omitted or an input-derived display field was shortened to its contract maximum."
    },
    "candidates": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": ["id", "type", "operation", "xpath", "value", "alt", "section_heading", "parent_tag", "marker_kind"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^c(?:[1-9]|[1-9][0-9]|1[0-9]{2}|200)$"},
          "type": {"enum": ["text", "image", "link"]},
          "operation": {"enum": ["replace_text", "replace_image", "replace_href"]},
          "xpath": {
            "type": "string",
            "pattern": "^/([a-z0-9-]+\\[[1-9][0-9]*\\]|text\\(\\)\\[[1-9][0-9]*\\])(/([a-z0-9-]+\\[[1-9][0-9]*\\]|text\\(\\)\\[[1-9][0-9]*\\]))*$",
            "maxLength": 2000
          },
          "value": {"type": "string", "maxLength": 10000},
          "alt": {"type": ["string", "null"], "maxLength": 1000},
          "section_heading": {"type": ["string", "null"], "maxLength": 1000},
          "parent_tag": {"type": ["string", "null"], "maxLength": 32},
          "marker_kind": {"type": ["string", "null"], "maxLength": 64}
        },
        "oneOf": [
          {"properties": {"type": {"const": "text"}, "operation": {"const": "replace_text"}}},
          {"properties": {"type": {"const": "image"}, "operation": {"const": "replace_image"}}},
          {"properties": {"type": {"const": "link"}, "operation": {"const": "replace_href"}}}
        ]
      }
    }
  }
}
