{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.magic-html.dev/v1/forms/definition.json",
  "type": "object",
  "required": ["contract_version", "name", "fields", "origins"],
  "additionalProperties": false,
  "properties": {
    "contract_version": {"const": "1.0"},
    "name": {"type": "string", "minLength": 1, "maxLength": 255},
    "fields": {"type": "object", "minProperties": 1},
    "origins": {"type": "array", "minItems": 1, "items": {"type": "string", "format": "uri"}},
    "notify_to": {"type": ["string", "null"], "format": "email"},
    "honeypot": {"type": "string", "minLength": 1, "maxLength": 100, "default": "_mh_hp"}
  }
}
