{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.magic-html.dev/v1/interview/message.json",
  "title": "Structured interview message",
  "type": "object",
  "required": ["role", "content", "field"],
  "additionalProperties": false,
  "properties": {
    "role": {"enum": ["assistant", "user"]},
    "content": {"type": "string", "minLength": 1, "maxLength": 8000},
    "field": {"enum": ["organization", "goals", "audience", "tone", "requirements", "materials"]}
  }
}
