{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.magic-html.dev/v1/interview/start-request.json",
  "title": "Start structured interview request",
  "type": "object",
  "required": ["contract_version", "site_id"],
  "additionalProperties": false,
  "properties": {
    "contract_version": {"const": "1.0"},
    "site_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,99}$"},
    "locale": {"type": "string", "minLength": 2, "maxLength": 20, "default": "ja"}
  }
}
