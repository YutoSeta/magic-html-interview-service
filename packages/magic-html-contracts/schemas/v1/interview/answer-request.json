{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.magic-html.dev/v1/interview/answer-request.json",
  "title": "Answer structured interview question request",
  "type": "object",
  "required": ["contract_version", "expected_step", "answer"],
  "additionalProperties": false,
  "properties": {
    "contract_version": {"const": "1.0"},
    "expected_step": {"type": "integer", "minimum": 0, "maximum": 6},
    "answer": {"type": "string", "minLength": 1, "maxLength": 8000}
  }
}
