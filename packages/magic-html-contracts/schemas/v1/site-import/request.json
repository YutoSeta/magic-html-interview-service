{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.magic-html.dev/v1/site-import/request.json",
  "title": "Static site import request",
  "type": "object",
  "required": ["contract_version", "site_id", "files"],
  "additionalProperties": false,
  "properties": {
    "contract_version": {"const": "1.0"},
    "site_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,99}$"},
    "normalize_html": {"type": "boolean", "default": true},
    "source": {
      "type": "object",
      "required": ["type", "reference"],
      "additionalProperties": false,
      "properties": {
        "type": {"enum": ["upload", "github", "sftp", "ftps", "ftp"]},
        "reference": {"type": "string", "minLength": 1, "maxLength": 1000}
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": ["path", "content_base64"],
        "additionalProperties": false,
        "properties": {
          "path": {"type": "string", "minLength": 1, "maxLength": 1000},
          "content_base64": {"type": "string", "minLength": 1, "maxLength": 70000000}
        }
      }
    }
  }
}
