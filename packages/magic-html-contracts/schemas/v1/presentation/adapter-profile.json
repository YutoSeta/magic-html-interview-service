{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.magic-html.dev/v1/presentation/adapter-profile.json",
  "title": "Magic HTML Presentation Adapter Profile",
  "description": "A version-pinned selection of deterministic presentation adapters. Adapter identifiers are registry keys, never class names, package URLs, executable code, or provider credentials.",
  "type": "object",
  "required": ["profile_id", "component_adapter", "utility_adapter", "icon_adapter", "icon_style", "font_adapter", "font_family", "image_adapter", "catalog_locks"],
  "additionalProperties": false,
  "properties": {
    "profile_id": {"type": "string", "pattern": "^[a-z][a-z0-9.-]{0,99}$"},
    "component_adapter": {"type": "string", "pattern": "^[a-z][a-z0-9.-]{0,99}$"},
    "utility_adapter": {"type": "string", "pattern": "^[a-z][a-z0-9.-]{0,99}$"},
    "icon_adapter": {"type": "string", "pattern": "^[a-z][a-z0-9.-]{0,99}$"},
    "icon_style": {"enum": ["outline", "solid"]},
    "font_adapter": {"enum": ["system", "self-hosted", "licensed-self-hosted"]},
    "font_family": {"enum": ["sans", "sans-ja", "serif", "mono"]},
    "image_adapter": {"const": "relative-assets"},
    "catalog_locks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {"$ref": "#/$defs/catalogLock"}
    }
  },
  "$defs": {
    "catalogLock": {
      "type": "object",
      "required": ["provider", "version", "digest", "license_scope"],
      "additionalProperties": false,
      "properties": {
        "provider": {"type": "string", "pattern": "^[a-z][a-z0-9.-]{0,99}$"},
        "version": {"type": "string", "minLength": 1, "maxLength": 100},
        "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "license_scope": {"enum": ["open-source", "private-byo"]}
      }
    }
  }
}
