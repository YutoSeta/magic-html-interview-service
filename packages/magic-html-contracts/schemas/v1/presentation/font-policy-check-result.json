{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.magic-html.dev/v1/presentation/font-policy-check-result.json",
  "title": "Magic HTML Font Policy Check Result",
  "description": "Deterministic policy decision for a licensed self-hosted Google Fonts asset set. It is a technical contract check, not legal advice.",
  "type": "object",
  "required": ["contract_version", "set_id", "provider", "family", "policy_version", "eligible_for_materialization", "requirements", "warnings", "digest"],
  "additionalProperties": false,
  "properties": {
    "contract_version": {"const": "1.0"},
    "set_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,99}$"},
    "provider": {"const": "google-fonts"},
    "family": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._-]{0,99}$"},
    "policy_version": {"const": "google-fonts-self-host-v1"},
    "eligible_for_materialization": {"const": true},
    "requirements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {"enum": ["retain-license-text", "retain-copyright-notice", "serve-declared-woff2-only"]}
    },
    "warnings": {
      "type": "array",
      "maxItems": 10,
      "uniqueItems": true,
      "items": {"enum": ["font-subset-is-modified", "font-family-renamed-for-reserved-name"]}
    },
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
