{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.magic-html.dev/v1/layout/create-snapshot-result.json",
  "title": "Layout Snapshot resource result",
  "description": "The shared create, freeze, and get envelope for a write-once Layout Snapshot. Create returns a candidate/pending snapshot; freeze returns a new frozen/passed snapshot; get may return either stored state.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "layout_snapshot", "layout_snapshot_references", "storage"],
  "properties": {
    "contract_version": {"const": "1.0"},
    "layout_snapshot": {"$ref": "snapshot.json"},
    "layout_snapshot_references": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {"$ref": "reference.json"}
    },
    "storage": {"$ref": "#/$defs/storage"}
  },
  "$defs": {
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["write_once", "encrypted", "created_at", "expires_at", "ttl_seconds"],
      "properties": {
        "write_once": {"const": true},
        "encrypted": {"const": true},
        "created_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"},
        "ttl_seconds": {"type": "integer", "minimum": 600, "maximum": 2592000}
      }
    }
  }
}
