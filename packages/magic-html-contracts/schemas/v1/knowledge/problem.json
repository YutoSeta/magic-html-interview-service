{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.magic-html.dev/v1/knowledge/problem.json",
  "title": "Knowledge API problem",
  "type": "object",
  "required": ["contract_version", "type", "title", "status", "detail", "request_id"],
  "additionalProperties": false,
  "properties": {
    "contract_version": {"const": "1.0"},
    "type": {"enum": ["unauthorized", "validation_failed", "idempotency_conflict", "idempotency_in_progress", "knowledge_base_not_found", "ingestion_job_not_found", "knowledge_document_not_found", "unsupported_media_type", "payload_too_large", "index_not_ready", "retrieval_failed", "answer_generation_failed"]},
    "title": {"type": "string", "minLength": 1, "maxLength": 255},
    "status": {"enum": [401, 404, 409, 413, 415, 422, 503]},
    "detail": {"type": "string", "minLength": 1, "maxLength": 2000},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 255},
    "errors": {
      "type": "object",
      "maxProperties": 50,
      "additionalProperties": {"type": "array", "maxItems": 20, "items": {"type": "string", "minLength": 1, "maxLength": 1000}}
    }
  }
}
