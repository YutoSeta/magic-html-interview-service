{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.magic-html.dev/v1/knowledge/match.json",
  "title": "Knowledge hybrid search match",
  "type": "object",
  "required": ["chunk_id", "document_id", "chunk_ordinal", "content", "semantic_rank", "keyword_rank", "fused_score", "metadata"],
  "additionalProperties": false,
  "properties": {
    "chunk_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "document_id": {"type": "string", "format": "uuid"},
    "chunk_ordinal": {"type": "integer", "minimum": 0, "maximum": 9999},
    "content": {"type": "string", "minLength": 1, "maxLength": 12000},
    "semantic_rank": {"type": ["integer", "null"], "minimum": 1, "maximum": 200},
    "keyword_rank": {"type": ["integer", "null"], "minimum": 1, "maximum": 200},
    "fused_score": {"type": "number", "minimum": 0},
    "metadata": {"$ref": "document-metadata.json"}
  },
  "anyOf": [
    {"properties": {"semantic_rank": {"type": "integer"}}},
    {"properties": {"keyword_rank": {"type": "integer"}}}
  ]
}
