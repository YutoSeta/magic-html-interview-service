{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.magic-html.dev/v1/knowledge/answer-response.json",
  "title": "Cite-or-refuse knowledge answer",
  "type": "object",
  "required": ["contract_version", "tenant_id", "knowledge_base_id", "question", "grounding_policy", "outcome", "answer", "citations", "refusal_reason", "index_revision"],
  "additionalProperties": false,
  "properties": {
    "contract_version": {"const": "1.0"},
    "tenant_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,99}$"},
    "knowledge_base_id": {"type": "string", "format": "uuid"},
    "question": {"type": "string", "minLength": 1, "maxLength": 4000},
    "grounding_policy": {"const": "strict_grounded"},
    "outcome": {"enum": ["answered", "refused"]},
    "answer": {"type": ["string", "null"], "maxLength": 20000},
    "citations": {"type": "array", "maxItems": 20, "uniqueItems": true, "items": {"$ref": "citation.json"}},
    "refusal_reason": {"enum": ["no_relevant_sources", "insufficient_evidence", "conflicting_evidence", null]},
    "index_revision": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "oneOf": [
    {
      "properties": {
        "outcome": {"const": "answered"},
        "answer": {"type": "string", "minLength": 1, "maxLength": 20000},
        "citations": {"type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": {"$ref": "citation.json"}},
        "refusal_reason": {"type": "null"}
      }
    },
    {
      "properties": {
        "outcome": {"const": "refused"},
        "answer": {"type": "null"},
        "citations": {"type": "array", "maxItems": 0},
        "refusal_reason": {"enum": ["no_relevant_sources", "insufficient_evidence", "conflicting_evidence"]}
      }
    }
  ]
}
