{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.magic-html.dev/v1/knowledge/search-response.json",
  "title": "Deterministic hybrid search response",
  "type": "object",
  "required": ["contract_version", "tenant_id", "knowledge_base_id", "query", "ranking", "matches", "truncated"],
  "additionalProperties": false,
  "properties": {
    "contract_version": {"const": "1.0"},
    "tenant_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,99}$"},
    "knowledge_base_id": {"type": "string", "format": "uuid"},
    "query": {"type": "string", "minLength": 1, "maxLength": 4000},
    "ranking": {
      "type": "object",
      "required": ["strategy", "semantic_weight", "keyword_weight", "rrf_k", "tie_breaker", "index_revision"],
      "additionalProperties": false,
      "properties": {
        "strategy": {"const": "weighted_rrf_v1"},
        "semantic_weight": {"type": "integer", "minimum": 0, "maximum": 100},
        "keyword_weight": {"type": "integer", "minimum": 0, "maximum": 100},
        "rrf_k": {"const": 60},
        "tie_breaker": {"const": "fused_score_desc_chunk_id_asc"},
        "index_revision": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "matches": {"type": "array", "maxItems": 50, "items": {"$ref": "match.json"}},
    "truncated": {"type": "boolean"}
  }
}
