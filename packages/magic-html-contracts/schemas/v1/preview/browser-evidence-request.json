{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.magic-html.dev/v1/preview/browser-evidence-request.json",
  "title": "Capture same-run Preview browser evidence",
  "description": "Runs one isolated Puppeteer/CDP session and captures three to ten viewport screenshots together with deterministic DOM geometry and accessibility evidence. Rest captures at 390, 768, and 1440 CSS pixels are mandatory.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "subject_digest", "provider", "viewports"],
  "properties": {
    "contract_version": {"const": "1.0"},
    "subject_digest": {"$ref": "#/$defs/digest"},
    "provider": {"enum": ["local_puppeteer", "cloudflare_browser_run_cdp"]},
    "format": {"enum": ["png", "jpeg"], "default": "png"},
    "quality": {"type": "integer", "minimum": 1, "maximum": 100, "default": 90},
    "viewports": {
      "type": "array",
      "minItems": 3,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/viewport"},
      "allOf": [
        {"contains": {"$ref": "#/$defs/rest390"}, "minContains": 1},
        {"contains": {"$ref": "#/$defs/rest768"}, "minContains": 1},
        {"contains": {"$ref": "#/$defs/rest1440"}, "minContains": 1}
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"format": {"const": "jpeg"}}, "required": ["format"]},
      "else": {"not": {"required": ["quality"]}}
    }
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "captureState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "target_id", "elapsed_ms"],
      "properties": {
        "kind": {"enum": ["rest", "enter"]},
        "target_id": {"type": "null"},
        "elapsed_ms": {"type": "integer", "minimum": 0, "maximum": 5000}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "rest"}}, "required": ["kind"]},
          "then": {"properties": {"elapsed_ms": {"const": 0}}}
        }
      ]
    },
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "capture_state"],
      "properties": {
        "width": {"type": "integer", "minimum": 320, "maximum": 3840},
        "height": {"type": "integer", "minimum": 240, "maximum": 2160},
        "capture_state": {"$ref": "#/$defs/captureState"}
      }
    },
    "rest390": {"properties": {"width": {"const": 390}, "capture_state": {"properties": {"kind": {"const": "rest"}, "elapsed_ms": {"const": 0}}, "required": ["kind", "elapsed_ms"]}}, "required": ["width", "capture_state"]},
    "rest768": {"properties": {"width": {"const": 768}, "capture_state": {"properties": {"kind": {"const": "rest"}, "elapsed_ms": {"const": 0}}, "required": ["kind", "elapsed_ms"]}}, "required": ["width", "capture_state"]},
    "rest1440": {"properties": {"width": {"const": 1440}, "capture_state": {"properties": {"kind": {"const": "rest"}, "elapsed_ms": {"const": 0}}, "required": ["kind", "elapsed_ms"]}}, "required": ["width", "capture_state"]}
  }
}
