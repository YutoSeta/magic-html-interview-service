{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.magic-html.dev/v1/preview/screenshot-result.json",
  "title": "Preview screenshot result",
  "type": "object",
  "required": ["contract_version", "preview_id", "mime_type", "width", "height", "full_page", "content_base64", "sha256"],
  "additionalProperties": false,
  "properties": {
    "contract_version": {"enum": ["1.0", "1.1", "1.2", "1.3"]},
    "preview_id": {"type": "string", "format": "uuid"},
    "mime_type": {"enum": ["image/png", "image/jpeg"]},
    "width": {"type": "integer", "minimum": 320, "maximum": 3840},
    "height": {"type": "integer", "minimum": 240},
    "full_page": {"type": "boolean"},
    "renderer": {"enum": ["local", "cloudflare"]},
    "snapshot_id": {"type": "string", "minLength": 1, "maxLength": 255},
    "entry_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))[A-Za-z0-9._@+ -]+(?:/[A-Za-z0-9._@+ -]+)*\\.[Hh][Tt][Mm][Ll]?$"
    },
    "capture_state": {"$ref": "screenshot-request.json#/$defs/captureState"},
    "capture_receipt": {
      "type": "string",
      "minLength": 16,
      "maxLength": 4096,
      "pattern": "^v1\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$",
      "description": "Preview-issued HMAC receipt binding the resource, stored snapshot, entry path, renderer, viewport, full-page flag, capture state, MIME type, image digest, and validity interval."
    },
    "content_base64": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "allOf": [
    {
      "if": {"properties": {"contract_version": {"const": "1.0"}}, "required": ["contract_version"]},
      "then": {"not": {"required": ["renderer"]}}
    },
    {
      "if": {"properties": {"contract_version": {"const": "1.1"}}, "required": ["contract_version"]},
      "then": {"required": ["renderer"]}
    },
    {
      "if": {"properties": {"contract_version": {"const": "1.2"}}, "required": ["contract_version"]},
      "then": {"required": ["renderer", "snapshot_id", "entry_path"]}
    },
    {
      "if": {"properties": {"contract_version": {"const": "1.3"}}, "required": ["contract_version"]},
      "then": {"required": ["renderer", "snapshot_id", "entry_path", "capture_state", "capture_receipt"]}
    }
  ]
}
