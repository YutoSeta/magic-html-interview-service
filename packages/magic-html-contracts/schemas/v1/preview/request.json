{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.magic-html.dev/v1/preview/request.json",
  "title": "Static site preview request",
  "type": "object",
  "required": ["contract_version", "site_id", "snapshot_id", "entry_path", "files"],
  "additionalProperties": false,
  "properties": {
    "contract_version": {"const": "1.0"},
    "site_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,99}$"},
    "snapshot_id": {"type": "string", "minLength": 1, "maxLength": 255},
    "entry_path": {"type": "string", "minLength": 1, "maxLength": 1000},
    "expires_in": {"type": "integer", "minimum": 300, "maximum": 86400, "default": 3600},
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": ["path", "content_base64"],
        "additionalProperties": false,
        "properties": {
          "path": {"type": "string", "minLength": 1, "maxLength": 1000},
          "mime": {"type": "string", "minLength": 1, "maxLength": 255},
          "content_base64": {"type": "string", "minLength": 1, "maxLength": 70000000}
        }
      }
    }
  }
}
