{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.magic-html.dev/v1/composer-ast/operations-request.json",
  "title": "Atomic Composer AST operations request",
  "description": "Idempotency-Key and a strong If-Match equal to base_revision are required HTTP headers and intentionally do not appear in this body.",
  "type": "object",
  "required": ["contract_version", "base_revision", "operations"],
  "additionalProperties": false,
  "properties": {
    "contract_version": {"const": "1.0"},
    "base_revision": {"type": "integer", "minimum": 0},
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 25,
      "items": {"$ref": "operation.json"}
    }
  }
}
