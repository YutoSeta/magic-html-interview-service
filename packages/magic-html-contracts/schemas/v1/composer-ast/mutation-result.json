{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.magic-html.dev/v1/composer-ast/mutation-result.json",
  "title": "Composer AST atomic mutation result",
  "type": "object",
  "required": ["contract_version", "data"],
  "additionalProperties": false,
  "properties": {
    "contract_version": {"const": "1.0"},
    "data": {
      "type": "object",
      "required": ["artifact", "operation_id", "action", "base_revision", "revision", "etag", "head_revision", "head_etag", "document_hash", "restored_from_revision", "applied", "document", "created_at"],
      "additionalProperties": false,
      "properties": {
        "artifact": {"$ref": "artifact.json"},
        "operation_id": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
        "action": {"enum": ["operations", "restore"]},
        "base_revision": {"type": "integer", "minimum": 0},
        "revision": {"type": "integer", "minimum": 1},
        "etag": {"type": "string", "pattern": "^\"(0|[1-9][0-9]*)\"$"},
        "head_revision": {"type": "integer", "minimum": 1},
        "head_etag": {"type": "string", "pattern": "^\"(0|[1-9][0-9]*)\"$"},
        "document_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "restored_from_revision": {
          "oneOf": [
            {"type": "integer", "minimum": 0},
            {"type": "null"}
          ]
        },
        "applied": {"type": "array", "maxItems": 25, "items": {"$ref": "applied-operation.json"}},
        "document": {"$ref": "ast-document.json"},
        "created_at": {"type": "string", "format": "date-time"}
      },
      "allOf": [
        {
          "if": {"properties": {"action": {"const": "operations"}}, "required": ["action"]},
          "then": {
            "properties": {
              "restored_from_revision": {"type": "null"},
              "applied": {"minItems": 1}
            }
          }
        },
        {
          "if": {"properties": {"action": {"const": "restore"}}, "required": ["action"]},
          "then": {
            "properties": {
              "restored_from_revision": {"type": "integer", "minimum": 0},
              "applied": {"maxItems": 0}
            }
          }
        }
      ]
    }
  }
}
