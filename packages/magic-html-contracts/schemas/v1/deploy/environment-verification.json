{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.magic-html.dev/v1/deploy/environment-verification.json",
  "title": "Deployment environment verification",
  "type": "object",
  "required": ["contract_version", "environment_id", "status", "checks", "checked_at"],
  "additionalProperties": false,
  "properties": {
    "contract_version": {"const": "1.0"},
    "environment_id": {"type": "string", "format": "uuid"},
    "status": {"enum": ["verified", "failed"]},
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["name", "status", "detail"],
        "additionalProperties": false,
        "properties": {
          "name": {"enum": ["credentials", "destination", "permissions"]},
          "status": {"enum": ["passed", "failed"]},
          "detail": {"type": ["string", "null"], "maxLength": 1000}
        }
      }
    },
    "checked_at": {"type": "string", "format": "date-time"}
  }
}
