{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.magic-html.dev/v1/site-source/fetch-job.json",
  "title": "Site Source Fetch Job",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "id", "tenant_id", "site_id", "connection_id", "status", "snapshot_id", "snapshot_digest", "file_count", "byte_size", "error", "created_at", "started_at", "finished_at"],
  "properties": {
    "contract_version": {"const": "1.0"},
    "id": {"type": "string", "format": "uuid"},
    "tenant_id": {"type": "string", "maxLength": 100},
    "site_id": {"type": "string", "maxLength": 100},
    "connection_id": {"type": "string", "format": "uuid"},
    "status": {"enum": ["queued", "running", "succeeded", "failed"]},
    "snapshot_id": {"type": ["string", "null"], "format": "uuid"},
    "snapshot_digest": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "file_count": {"type": ["integer", "null"], "minimum": 0, "maximum": 2000},
    "byte_size": {"type": ["integer", "null"], "minimum": 0, "maximum": 52428800},
    "error": {
      "anyOf": [
        {"type": "null"},
        {"type": "object", "additionalProperties": false, "required": ["code", "detail"], "properties": {"code": {"enum": ["provider_failed", "unsafe_source", "source_limit_exceeded"]}, "detail": {"type": "string", "minLength": 1, "maxLength": 500}}}
      ]
    },
    "created_at": {"type": "string", "format": "date-time"},
    "started_at": {"type": ["string", "null"], "format": "date-time"},
    "finished_at": {"type": ["string", "null"], "format": "date-time"}
  }
}
