{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.magic-html.dev/v1/build/request.json",
  "title": "Static site build request",
  "type": "object",
  "required": ["contract_version", "source"],
  "additionalProperties": false,
  "properties": {
    "contract_version": {"const": "1.0"},
    "source": {"$ref": "#/$defs/source"},
    "projection": {
      "type": "object",
      "required": ["pages"],
      "additionalProperties": false,
      "properties": {
        "pages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "required": ["path", "html"],
            "additionalProperties": false,
            "properties": {
              "path": {"type": "string", "pattern": "^/"},
              "html": {"type": "string", "minLength": 1, "maxLength": 2000000}
            }
          }
        },
        "css": {"type": "string", "maxLength": 2000000},
        "forms_endpoint": {"type": "string", "format": "uri"}
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": ["type", "site_id", "version"],
      "additionalProperties": false,
      "properties": {
        "type": {"enum": ["publication", "splash"]},
        "site_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,99}$"},
        "version": {"type": "string", "minLength": 1, "maxLength": 100}
      }
    }
  }
}
